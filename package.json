{
  "name": "kaafil-skills",
  "version": "0.1.0",
  "description": "AI-coding skills for Kaafil — teaches your agent to integrate the kaafil-js SDK and the kaafil-react-uikit React components correctly. Works with Claude Code, Cursor, Codex, Copilot, Cline, Kiro and more.",
  "keywords": [
    "kaafil",
    "claude-code",
    "claude-skill",
    "agent-skills",
    "mcp",
    "react",
    "ui-kit",
    "sdk",
    "group-travel",
    "travel-crm"
  ],
  "author": "Kaafil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaafil/kaafil-skills.git"
  },
  "homepage": "https://github.com/kaafil/kaafil-skills#readme",
  "bugs": {
    "url": "https://github.com/kaafil/kaafil-skills/issues"
  },
  "bin": {
    "kaafil-skills": "bin/install.js"
  },
  "files": [
    "bin/",
    "skills/"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "catalog": "node test-suite/scripts/build-catalog.mjs",
    "sandbox:install": "npm --prefix test-suite/typecheck/web install --no-audit --no-fund",
    "verify": "bash test-suite/scripts/verify.sh",
    "verify:catalog": "node test-suite/scripts/build-catalog.mjs --check && node test-suite/scripts/verify-symbols.mjs",
    "verify:fences": "node test-suite/scripts/typecheck-fences.mjs",
    "verify:all": "npm run verify && npm run verify:catalog && npm run verify:fences",
    "test:eval": "bash test-suite/scripts/run-eval.sh"
  }
}
